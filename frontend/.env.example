# Copy to .env (Prisma) / .env.local (Next). Never commit real keys.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&connect_timeout=15"

# AI adapter (docs/PRD.md section 8). Default is labelled mock mode.
AI_PROVIDER=mock            # mock | gemini | groq | ollama | lmstudio
AI_MODEL=                   # a model ID available on your account / local runtime
AI_API_KEY=                 # gemini / groq only
AI_BASE_URL=                # ollama / lmstudio only, loopback http
AI_TIMEOUT_MS=2000

# Paystack TEST keys only for the hackathon. Empty = simulated payment, clearly labelled.
PAYSTACK_SECRET_KEY=
APP_URL=http://localhost:3000

# Signs the demo session cookie and result download links.
SESSION_SECRET=change-me-to-a-long-random-string

# Live nearby places from Google Maps via Gemini (FR-027). Needs AI_PROVIDER=gemini. "off" disables.
LIVE_PLACES=on
# Model for the Google Maps lookup (can differ from AI_MODEL; pick the fastest that supports Maps grounding).
LIVE_PLACES_MODEL=gemini-3.1-flash-lite
