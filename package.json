{
  "name": "riomed-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w @riomed/frontend",
    "build": "npm run db:generate -w @riomed/backend && npm run build -w @riomed/frontend",
    "start": "npm run start -w @riomed/frontend",
    "test": "npm test -w @riomed/backend",
    "typecheck": "npm run typecheck -w @riomed/backend && npm run typecheck -w @riomed/frontend",
    "lint": "npm run lint -w @riomed/frontend",
    "eval": "npm run eval -w @riomed/backend",
    "db:push": "npm run db:push -w @riomed/backend",
    "db:seed": "npm run db:seed -w @riomed/backend",
    "smoke": "npm run smoke -w @riomed/backend",
    "postinstall": "npm run db:generate -w @riomed/backend"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
